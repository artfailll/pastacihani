        { "@type": "Question", "name": "Kaç gün önceden sipariş vermeliyim?", "acceptedAnswer": { "@type": "Answer", "text": "Özel tasarım pastalar için en az 2-3 gün önceden sipariş vermenizi öneririz. Acil siparişler için WhatsApp'tan durumu birlikte değerlendiriyoruz." } },
        { "@type": "Question", "name": "Glutensiz veya şekersiz pasta yapıyor musunuz?", "acceptedAnswer": { "@type": "Answer", "text": "Evet, glutensiz ve şekersiz seçenekler sunabiliyoruz. Diyet gereksinimlerinizi sipariş sırasında belirtmeniz yeterli." } },
        { "@type": "Question", "name": "Özel tasarım pasta yaptırabilir miyim?", "acceptedAnswer": { "@type": "Answer", "text": "Kesinlikle! 3D tasarım aracımızla renk, tema ve detayları kendiniz belirleyebilir ya da bize konseptinizi anlatabilirsiniz. Her pasta tamamen size özel tasarlanır." } }
