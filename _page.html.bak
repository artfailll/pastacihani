<script src="38f00ad7-1a86-4ec8-9968-0dfb4b3c6d24"></script>
<script src="cebf6828-c321-4da2-9dbd-d93e7edc9f4b"></script>
<script src="2fa2de86-4aec-4a15-bb5b-fe72aca1c44f"></script>
<script src="d9e00edc-cb00-4e84-bf3c-fc36c9fc6a3d"></script>

<script>
/* HERO 3D pasta halkası — galeri kategorilerinden gerçek Cloudinary görselleri */
(function () {
  var ring = document.getElementById("heroRing");
  if (!ring || ring.children.length) return;

  var CLOUD = "do7gjdvb0";
  var CATS = [
    { slug: "dogumgunu",  label: "Doğum Günü" },
    { slug: "nisan",      label: "Nişan" },
    { slug: "soz",        label: "Söz" },
    { slug: "dugun",      label: "Düğün" },
    { slug: "babyshower", label: "Baby Shower" },
    { slug: "yildonumu",  label: "Yıldönümü" }
  ];

  var n = CATS.length, ang = 360 / n;

  function coverUrl(r) {
    return "https://res.cloudinary.com/" + CLOUD + "/image/upload/f_auto,q_auto,w_420,c_fill,ar_4:5/v" + r.version + "/" + r.public_id + "." + r.format;
  }

  function layout() {
    var cards = ring.querySelectorAll(".hero-card");
    if (!cards.length) return;
    // 1.05 → kartlar birbirine yakın, dramatik coverflow görünümü
    var r = Math.round((cards[0].offsetWidth || 190) * 1.05);
    cards.forEach(function (c, i) {
      c.style.transform = "translate(-50%,-50%) rotateY(" + (i * ang) + "deg) translateZ(" + r + "px)";
    });
  }

  function addCard(cat, imgSrc) {
    var c = document.createElement("a");
    c.className = "hero-card";
    c.href = "/galeri?kat=" + cat.slug;
    c.setAttribute("aria-label", cat.label + " pastalarını gör");
    if (imgSrc) {
      var img = document.createElement("img");
      img.decoding = "async";
      img.alt = cat.label + " pasta tasarımı";
      img.src = imgSrc;
      c.appendChild(img);
    }
    var lbl = document.createElement("span");
    lbl.className = "hero-card-label";
    lbl.innerHTML = cat.label.replace(/[<>&]/g, "") + '<span class="gör">Galeride Gör →</span>';
    c.appendChild(lbl);
    ring.appendChild(c);
  }

  Promise.all(CATS.map(function (cat) {
    return fetch("https://res.cloudinary.com/" + CLOUD + "/image/list/" + cat.slug + ".json?ts=" + Date.now())
      .then(function (res) { return res.ok ? res.json() : { resources: [] }; })
      .then(function (d) { return { cat: cat, res: (d.resources || [])[0] || null }; })
      .catch(function () { return { cat: cat, res: null }; });
  })).then(function (results) {
    results.forEach(function (item) {
      addCard(item.cat, item.res ? coverUrl(item.res) : "");
    });
    layout();
    window.addEventListener("resize", layout);
  });
})();

/* HERO arka plan — süzülen serpme/şeker taneleri (zarif, yavaş) */
(function () {
  var fx = document.getElementById("heroFx");
  if (!fx || fx.querySelector(".p")) return;
  if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  var colors = ["#B0697F", "#C2A062", "#8E3B57", "#DcC79A"];
  var N = window.innerWidth < 600 ? 14 : 22;
  for (var i = 0; i < N; i++) {
    var p = document.createElement("span");
    var isSprinkle = Math.random() > 0.42;
    p.className = "p " + (isSprinkle ? "sprinkle" : "dot");
    var c = colors[i % colors.length];
    p.style.left = (Math.random() * 100).toFixed(2) + "%";
    p.style.background = c;
    var dur = 13 + Math.random() * 15;
    p.style.animation = "heroFloatUp " + dur.toFixed(1) + "s linear " + (-Math.random() * dur).toFixed(1) + "s infinite";
    p.style.setProperty("--r", (Math.random() * 360 - 180).toFixed(0) + "deg");
    p.style.setProperty("--o", (0.22 + Math.random() * 0.4).toFixed(2));
    if (isSprinkle) {
      p.style.transform = "rotate(" + (Math.random() * 180).toFixed(0) + "deg)";
    } else {
      var s = (4 + Math.random() * 9).toFixed(0);
      p.style.width = s + "px"; p.style.height = s + "px";
    }
    fx.appendChild(p);
  }
})();

/* HERO RING — fare + dokunmatik sürükleme (çark gibi döner, momentum ile yavaşlar) */
(function () {
  var ring  = document.getElementById("heroRing");
  var stage = ring && ring.closest(".hero-ring-stage");
  if (!ring || !stage) return;

  var angle = 0, vel = 0;
  var dragging = false, prevX = 0, prevT = 0;
  var AUTO = -360 / 52000; // deg/ms — 52 saniyede tam tur

  function draw() { ring.style.transform = "rotateY(" + angle.toFixed(3) + "deg)"; }

  var rafPrev = 0;
  function tick(ts) {
    var dt = Math.min(ts - (rafPrev || ts), 60); rafPrev = ts;
    if (!dragging) {
      if (Math.abs(vel) > 0.004) {
        vel *= Math.pow(0.982, dt); // sürtünme ile yavaşla
        angle += vel * dt;
      } else {
        vel = 0;
        angle += AUTO * dt; // oto-dönüş
      }
    }
    draw();
    requestAnimationFrame(tick);
  }

  function onDown(x) {
    dragging = true; prevX = x; prevT = performance.now(); vel = 0;
    stage.style.cursor = "grabbing";
  }
  function onMove(x) {
    if (!dragging) return;
    var t = performance.now(), dt = t - prevT;
    var dx = x - prevX;
    if (dt > 0) vel = (dx * 0.38) / dt;
    angle += dx * 0.38;
    prevX = x; prevT = t;
    draw();
  }
  function onUp() {
    if (!dragging) return;
    dragging = false; stage.style.cursor = "grab";
  }

  /* mouse */
  stage.addEventListener("mousedown", function (e) { e.preventDefault(); onDown(e.clientX); });
  window.addEventListener("mousemove", function (e) { onMove(e.clientX); });
  window.addEventListener("mouseup",   onUp);
  /* touch */
  stage.addEventListener("touchstart", function (e) { onDown(e.touches[0].clientX); }, { passive: true });
  stage.addEventListener("touchmove",  function (e) {
    if (dragging) { e.preventDefault(); onMove(e.touches[0].clientX); }
  }, { passive: false });
  stage.addEventListener("touchend", onUp);

  /* CSS animasyonunu JS'e devret (kartlar yüklenince) */
  function startLoop() {
    if (!ring.children.length) { setTimeout(startLoop, 250); return; }
    ring.style.animation = "none";
    stage.style.cursor = "grab";
    requestAnimationFrame(tick);
  }
  startLoop();
})();

</script>



</body></html>