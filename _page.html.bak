<section class="section wizard-sec" id="sihirbaz">
  <div class="wrap">
    <div class="sec-head reveal">
      <div class="hl">
        <span class="kicker">3 Adımda</span>
        <h2>Hızlı Sipariş Sihirbazı</h2>
      </div>
      <p class="meta">Birkaç soruyla size en uygun pastaları anında listeleyelim.</p>
    </div>
    <div class="wizard reveal" id="wizard">
      <div class="wiz-progress">
        <div class="wiz-dot active" data-step="1"><span class="num">1</span><span class="lbl">Tarih</span></div>
        <span class="wiz-line"></span>
        <div class="wiz-dot" data-step="2"><span class="num">2</span><span class="lbl">Kişi</span></div>
        <span class="wiz-line"></span>
        <div class="wiz-dot" data-step="3"><span class="num">3</span><span class="lbl">Tür</span></div>
        <span class="wiz-line"></span>
        <div class="wiz-dot" data-step="4"><span class="num">✓</span><span class="lbl">Sonuç</span></div>
      </div>

      <div class="wiz-step active" data-step="1">
        <h3 class="wiz-q">Pasta hangi gün için?</h3>
        <div class="wiz-opts" id="wizDay">
          <button class="wiz-opt" data-val="Bugün"><span class="wo-ic">⚡</span><span class="wo-t">Bugün</span></button>
          <button class="wiz-opt" data-val="Yarın"><span class="wo-ic">🌤️</span><span class="wo-t">Yarın</span></button>
          <button class="wiz-opt" data-val="Hafta sonu"><span class="wo-ic">🎉</span><span class="wo-t">Hafta Sonu</span></button>
          <button class="wiz-opt" data-val="İleri tarih"><span class="wo-ic">📅</span><span class="wo-t">İleri Tarih</span></button>
        </div>
      </div>

      <div class="wiz-step" data-step="2">
        <h3 class="wiz-q">Kaç kişilik olsun?</h3>
        <div class="wiz-people">
          <div class="wiz-num">
            <button type="button" id="wizMinus" aria-label="Azalt">−</button>
            <input type="number" id="wizPeople" min="1" max="500" step="1" value="10" inputmode="numeric" aria-label="Kişi sayısı">
            <button type="button" id="wizPlus" aria-label="Artır">+</button>
          </div>
          <span class="meta" style="color:var(--ink-soft)">1 - 500 kişi arasında girebilirsiniz.</span>
        </div>
      </div>

      <div class="wiz-step" data-step="3">
        <h3 class="wiz-q">Hangi tür pasta?</h3>
        <div class="wiz-chips" id="wizType">
          <button class="wiz-chip" data-cat="dogumgunu">Doğum Günü</button>
          <button class="wiz-chip" data-cat="nisan">Nişan</button>
          <button class="wiz-chip" data-cat="soz">Söz</button>
          <button class="wiz-chip" data-cat="dugun">Düğün</button>
          <button class="wiz-chip" data-cat="babyshower">Baby Shower</button>
          <button class="wiz-chip" data-cat="yildonumu">Yıldönümü</button>
        </div>
      </div>

      <div class="wiz-step" data-step="4">
        <div class="wiz-result-head">
          <span class="kicker">Hazır</span>
          <h3>Sana uygun pastalar</h3>
          <p id="wizSummary"></p>
        </div>
        <div class="wiz-result-grid" id="wizResults"></div>
        <div class="wiz-gallery" id="wizGalleryStrip" hidden>
          <div class="wiz-gallery-head">
            <span class="wg-title">Galeriden örnekler</span>
            <a class="wg-more" id="wizGalleryMore" href="/galeri">Tüm galeri →</a>
          </div>
          <div class="wiz-gallery-grid" id="wizGalleryGrid" aria-label="Galeri örnekleri"></div>
        </div>
        <div class="wiz-cta-row">
          <a class="btn btn-fill" id="wizGallery" href="/galeri">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
            Galeride Gör
          </a>
          <a class="btn btn-wa" id="wizWa" target="_blank" rel="noopener" href="#">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.7 14.9L2 22l5.3-1.4A10 10 0 1 0 12 2Zm5.5 14.1c-.2.6-1.2 1.2-1.7 1.2-.4 0-1 .1-3.3-.9-2.8-1.2-4.5-4.1-4.6-4.3-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.1c.2-.2.5-.3.6-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.5c-.2.2-.3.3-.1.6.5.8 1 1.3 1.7 1.8.2.1.4.1.5 0l.7-.8c.2-.2.3-.2.6-.1l1.8.9c.2.1.4.2.4.3.1.2.1.9-.1 1.6Z"></path></svg>
