<div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
  <div class="lb-bg" id="lbBg"></div>
  <div class="lb-stage">
    <button class="lb-close" id="lbClose" aria-label="Kapat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
    <button class="lb-nav prev" id="lbPrev" aria-label="Önceki"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg></button>
    <button class="lb-nav next" id="lbNext" aria-label="Sonraki"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></button>
    <div class="lb-frame" id="lbFrame"></div>
    <div class="lb-caption" id="lbCaption"></div>
  </div>
